PORT=3000
CORS_ORIGIN=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=DigestoUNSL

# Clave secreta para firmar los tokens: larga y aleatoria.
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración del token
JWT_EXPIRES_IN=1h

# Dirección de la API en Go (backend-go)
GO_API_URL=http://localhost:8080

# Carpeta donde se guardan los PDF de los documentos
ARCHIVOS_DIR=Digesto-datos/archivos

CRON_CONCURSOS="30 23 * * *"
CRON_PLANES="0 3 1 2,6,10 *"
DIGESTO_DOCS_URL=http://digesto.unsl.edu.ar/docs/
PAUSA_DESCARGAS=1000
ESPERA_GO=900000
